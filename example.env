# =============================================================================
# NHPLit  |  personal credentials
# =============================================================================
# Copy this file to key.env and fill in your values.
# key.env is gitignored and will never be committed.
#
# NCBI requires an email for all E-utilities requests.
# An API key is optional but raises the rate limit from 3 to 10 req/s.
# Get a free API key at: https://www.ncbi.nlm.nih.gov/account/
# =============================================================================

NCBI_EMAIL=your_email@example.com
NCBI_API_KEY=

# ---------------------------------------------------------------------------
# Stage 2 LLM provider — choose one: anthropic | openai_compat
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic

# Anthropic (default) — get key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI-compatible providers (DeepSeek, Qwen, Zhipu, etc.)
# Set LLM_PROVIDER=openai_compat above and fill in these two:
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=    # e.g. https://api.deepseek.com/v1
